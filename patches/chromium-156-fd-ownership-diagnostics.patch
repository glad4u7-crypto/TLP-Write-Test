   if (base::IsFDOwned(fd) && g_is_ownership_enforced) {
-    CrashOnFdOwnershipViolation();
+    CrashOnFdOwnershipViolation(fd, "close", /*previous_owned=*/true,
+                                /*requested_owned=*/false);
   }
