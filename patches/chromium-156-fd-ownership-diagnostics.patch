diff --git a/base/files/scoped_file_linux.cc b/base/files/scoped_file_linux.cc
index f911af6..0000000 100644
--- a/base/files/scoped_file_linux.cc
+++ b/base/files/scoped_file_linux.cc
@@ -11,6 +11,8 @@
 #include <dlfcn.h>
+#include <sys/syscall.h>
+#include <unistd.h>
 
 #include <algorithm>
 #include <array>
@@ -31,9 +33,20 @@
 std::atomic_bool g_is_ownership_enforced{false};
 std::array<std::atomic_bool, kMaxTrackedFds> g_is_fd_owned;
 
-NOINLINE void CrashOnFdOwnershipViolation() {
+// Diagnostic-only: this runs only immediately before the existing fatal crash.
+// It must not allocate, open, close, duplicate, or transfer a descriptor.
+NOINLINE void CrashOnFdOwnershipViolation(int fd,
+                                          const char* operation,
+                                          bool previous_owned,
+                                          bool requested_owned) {
+  const pid_t pid = getpid();
+  const long tid = syscall(SYS_gettid);
+  RAW_LOG(ERROR,
+          "APAA_FD_OWNERSHIP_DIAG fd=%d operation=%s previous_owned=%d "
+          "requested_owned=%d pid=%d tid=%ld\n",
+          fd, operation, previous_owned, requested_owned, pid, tid);
   RAW_LOG(ERROR, "Crashing due to FD ownership violation:\n");
   base::debug::StackTrace().Print();
   base::ImmediateCrash();
@@ -44,11 +57,17 @@
 void UpdateAndCheckFdOwnership(int fd, bool owned) {
-  if (CanTrack(fd) &&
-      g_is_fd_owned[static_cast<size_t>(fd)].exchange(owned) == owned &&
-      g_is_ownership_enforced) {
-    CrashOnFdOwnershipViolation();
+  if (!CanTrack(fd)) {
+    return;
+  }
+  const bool previous_owned =
+      g_is_fd_owned[static_cast<size_t>(fd)].exchange(owned);
+  if (previous_owned == owned && g_is_ownership_enforced) {
+    CrashOnFdOwnershipViolation(fd, owned ? "acquire" : "release",
+                                previous_owned, owned);
   }
 }
@@ -107,7 +126,8 @@
